{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}"
        },
        {
            "name": "Help command",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/package-runner",
            "windows": {
                "program": "${workspaceFolder}/package-runner.exe"
            },
            "args": ["--help"]
        },
        {
            "name": "resolve command",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/package-runner",
            "windows": {
                "program": "${workspaceFolder}/package-runner.exe"
            },
            "args": [
                "resolve",
                "--recipe",
                "./windows-vm.yaml",
                "--output",
                "./out/windows-vm.lock.yaml"
            ]
        },
        {
            "name": "install command",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/package-runner",
            "windows": {
                "program": "${workspaceFolder}/package-runner.exe"
            },
            "args":[
                "install",
                "-lock", ".\\out\\windows-vm.lock.yaml" 
            ]
        },
         {
            "name": "validate command",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/package-runner",
            "windows": {
                "program": "${workspaceFolder}/package-runner.exe"
            },
            "args":[
                "validate",
                "-lock", ".\\out\\windows-vm.lock.yaml",
                "--verify-artifacts"
            ]
        },

    ]
}